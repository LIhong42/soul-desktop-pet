# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# Electron / electron-builder build output
dist/
out/
build/
release/
*.exe
*.dmg
*.deb
*.AppImage
*.snap
*.blockmap
builder-effective-config.yaml
builder-debug.yml

# Local user data (the SQLite DB lives here on the user's machine, NOT in repo)
*.db
*.db-journal
*.db-shm
*.db-wal

# OS junk
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Env files (NEVER commit secrets)
.env
.env.local
.env.*.local

# Logs and runtime artifacts
*.log
logs/
.cache/
.tmp/
temp/
# Dotfile-prefixed scratch output at the repo root, e.g. the preview page
# generated by scripts/preview-textbox-picker.js. Regenerate on demand.
.tmp-*

# Coverage / test artifacts
coverage/
.nyc_output/
*.lcov

# Misc
*.tgz
.eslintcache
.prettiercache

# Pet asset binaries live in resources/pets/<id>/. Track only the
# manifest.json describing each pet; PNG frames are kept locally and shipped
# via electron-builder's extraResources. To regenerate from upstream vup
# sources, drop frames under resources/pets/<id>/ manually.
# info.lps is also legacy metadata we don't read; ignore it too.
#resources/pets/
reference/
.claude/