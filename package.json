{
  "name": "soul-desktop-pet",
  "version": "0.1.0",
  "description": "SoulDesktopPet — local-first relationship & reminders with a desktop pet",
  "main": "main/main.js",
  "author": "SoulDesktopPet",
  "license": "Apache-2.0",
  "scripts": {
    "start": "node scripts/run-electron.js .",
    "dev": "node scripts/run-electron.js . --dev",
    "doctor": "node scripts/doctor.js",
    "verify:cutout": "node scripts/verify-cutout.js",
    "verify:reminders": "node scripts/verify-reminders.js && node scripts/run-electron.js scripts/test-reminder-dismiss.js && node scripts/run-electron.js scripts/test-reminder-pill.js",
    "verify:quick-record": "node scripts/run-electron.js scripts/verify-quick-record.js && node scripts/run-electron.js scripts/test-quick-record-ui.js && node scripts/run-electron.js scripts/test-form-parity.js",
    "verify:diary": "node scripts/verify-diary-db.js && node scripts/run-electron.js scripts/test-diary-editor.js",
    "test:pet-drag": "node scripts/test-pet-drag.js && node scripts/test-pet-drag-order.js && node scripts/test-pet-drag-main.js && node scripts/test-pet-resume.js && node scripts/test-pet-input-probe.js && node scripts/test-gesture-guard.js && node scripts/run-electron.js scripts/test-pet-drag-e2e.js && node scripts/run-electron.js scripts/test-pet-drag-live.js && node scripts/run-electron.js scripts/test-pet-resume-live.js && node scripts/run-electron.js scripts/test-app-relaunch.js && node scripts/run-electron.js scripts/test-album-gesture.js",
    "measure:text-boxes": "node scripts/measure-text-boxes.js",
    "install:bin": "node scripts/install-electron-bin.js",
    "postinstall": "node scripts/install.js",
    "prebuild": "node scripts/hoist-call-bind-helpers.js && node scripts/prebuild-extract-winCodeSign.js",
    "build": "npm run prebuild && electron-builder",
    "build:dir": "npm run prebuild && electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "call-bind-apply-helpers": "^1.0.2",
    "es-errors": "^1.3.0",
    "es-set-tostringtag": "^2.1.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "function-bind": "^1.1.2",
    "get-intrinsic": "^1.3.0",
    "gopd": "^1.2.0",
    "has-symbols": "^1.1.0",
    "hasown": "^2.0.4",
    "lunar-javascript": "^1.6.13",
    "pdfkit": "^0.15.1",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "com.souldesktoppet.app",
    "productName": "SoulDesktopPet",
    "asar": false,
    "files": [
      "main/**/*",
      "pet/**/*",
      "src/**/*",
      "resources/**/*",
      "icons/icon.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**",
      "!node_modules/.bin/**",
      "!node_modules/@electron/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/electron-builder-lib/**",
      "!node_modules/jsdom/**",
      "!node_modules/7zip-bin/**",
      "!node_modules/app-builder/**",
      "!node_modules/app-builder-bin/**",
      "!node_modules/dmg-license/**",
      "!node_modules/macos-alias/**",
      "!node_modules/{electron,electron-builder,jsdom,7zip-bin}/**"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoulDesktopPet",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
